# Telegram Bot API token from @BotFather
BOT_TOKEN=

# Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Optional system instruction (empty = not sent)
GEMINI_SYSTEM_PROMPT=
# Timeout for the whole streamed answer, seconds
GEMINI_TIMEOUT_SEC=120

# Access control. Owner numeric Telegram user ID (required)
OWNER_ID=
# Comma-separated numeric user IDs
ALLOWED_USERS=
# Comma-separated usernames without @
ALLOWED_USERNAMES=

# Requests per user per minute
RATE_LIMIT_PER_MINUTE=20
# Minimal interval between draft updates, ms
DRAFT_INTERVAL_MS=300

TZ=Europe/Luxembourg
LOG_LEVEL=INFO
